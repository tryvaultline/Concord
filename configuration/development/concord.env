# Concord Development Configuration Parameters

APP_NAME=Concord
APP_HOST=localhost
APP_PORT=8080
API_BASE_URL=http://localhost:8080/v1
WS_URL=ws://localhost:8080/v1/websocket/
MEDIA_CDN_URL=http://localhost:9000/attachments

# Feature Flags
FEATURE_PHONE_NUMBER_AUTH=false
FEATURE_CONCORD_USERNAME_AUTH=true
FEATURE_SEALED_SENDER=true
FEATURE_KYBER_PREKEYS=true
FEATURE_MULTI_ACCOUNT_ISOLATION=true

# Security Settings
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
