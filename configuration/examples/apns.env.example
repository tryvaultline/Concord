# Concord APNs Configuration Template Example
# Populate these environment variables on your production push notification server

# Apple Developer Team ID (10-character alphanumeric ID from Apple Developer Portal)
CONCORD_APNS_TEAM_ID=XXXXXXXXXX

# APNs Key ID for the push notification signing key (.p8 file)
CONCORD_APNS_KEY_ID=YYYYYYYYYY

# Path to the APNs AuthKey p8 file
CONCORD_APNS_PRIVATE_KEY_PATH=/etc/concord/apns/AuthKey_YYYYYYYYYY.p8

# Concord App Main Bundle Identifier
CONCORD_APNS_BUNDLE_ID=app.concord.ios

# APNs Sandbox / Production Environment
CONCORD_APNS_PRODUCTION=false
