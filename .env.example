# Concord Local Environment Template
# DO NOT ADD REAL PRODUCTION SECRETS TO THIS FILE

# Service Binding
CONCORD_AUTH_PORT=8080
CONCORD_REDIS_PORT=6379
CONCORD_MINIO_PORT=9000
CONCORD_MINIO_CONSOLE_PORT=9001
CONCORD_DB_PORT=5432

# Development mode
CONCORD_ENV=development

# Local object storage credentials. Generate unique values in .env.local.
CONCORD_STORAGE_ACCESS_KEY=SET_A_LOCAL_STORAGE_ACCESS_KEY
CONCORD_STORAGE_SECRET_KEY=SET_A_LOCAL_STORAGE_SECRET

# Push Notification Settings (APNs)
CONCORD_APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
CONCORD_APNS_KEY_ID=YOUR_APNS_KEY_ID
CONCORD_APNS_BUNDLE_ID=app.concord.ios
CONCORD_APNS_PRIVATE_KEY_PATH=/etc/concord/apns/AuthKey.p8

# Development Seed Accounts (DO NOT PUT REAL CREDENTIALS)
SEED_ACCOUNT_1_USERNAME=SET_LOCALLY
SEED_ACCOUNT_1_PASSWORD=SET_A_LOCAL_PASSWORD_AT_LEAST_8_CHARS
SEED_ACCOUNT_1_DISPLAY_NAME=SET_LOCALLY

SEED_ACCOUNT_2_USERNAME=SET_LOCALLY
SEED_ACCOUNT_2_PASSWORD=SET_A_DIFFERENT_LOCAL_PASSWORD_AT_LEAST_8_CHARS
SEED_ACCOUNT_2_DISPLAY_NAME=SET_LOCALLY
